---
# Keep the style close to the OBS codebase: tabs, Linux braces and a wide
# enough column limit for the widescreen property tables.
Language: Cpp
BasedOnStyle: LLVM
Standard: c++17
IndentWidth: 8
ContinuationIndentWidth: 8
TabWidth: 8
UseTab: Always
BreakBeforeBraces: Linux
ColumnLimit: 100
AlignAfterOpenBracket: Align
AlignOperands: Align
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
PointerAlignment: Right
SpaceAfterCStyleCast: false
SortIncludes: Never
